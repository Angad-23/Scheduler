# Copy these into IntelliJ: Run > Edit Configurations > SchedulerApplication > Environment variables
# (or set them on Render). Never commit real passwords to git.

APP_MAIL_LOG_ONLY=false
APP_BRAND_NAME=Trivium Scheduler
APP_MAIL_FROM_NAME=Trivium Scheduler

# --- Google Workspace / Gmail (app password, needs 2-Step Verification on the sending account) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=scheduler@yourcompany.com
MAIL_PASSWORD=abcdefghijklmnop
APP_MAIL_FROM=scheduler@yourcompany.com

# --- or Microsoft 365 (SMTP AUTH must be enabled for this mailbox by your admin) ---
# MAIL_HOST=smtp.office365.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=scheduler@yourcompany.com
# MAIL_PASSWORD=...
# APP_MAIL_FROM=scheduler@yourcompany.com

# --- or Brevo's web API (works on Render's free plan, where SMTP ports are blocked) ---
# APP_MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# APP_MAIL_FROM=eurekii@triviumedu.com      (must be verified as a sender in Brevo)

# Link in the verification email must point at where students open the app
APP_BASE_URL=http://localhost:8080

# Real supervisor address (only used to create the account if it doesn't exist yet)
APP_ADMIN_EMAIL=supervisor@yourcompany.com
APP_ADMIN_PASSWORD=ChooseAStrongOne!
